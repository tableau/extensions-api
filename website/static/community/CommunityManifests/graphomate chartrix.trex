<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
    <worksheet-extension id="com.graphomate.viz.chatrix.latest" extension-version="1.0.0">
        <default-locale>en_US</default-locale>
        <name resource-id="name"/>
        <description>graphomate chartrix</description>
        <author name="graphomate GmbH" email="info@graphomate.com" organization="graphomate GmbH" website="https://www.graphomate.com"/>
        <min-api-version>1.11</min-api-version>
        <source-location>
            <url>https://content.graphomate.com/tableau/chartrix/latest/index.html</url>
        </source-location> <icon>
    </icon>
        <permissions>
            <permission>full data</permission>
        </permissions>
        <context-menu>
            <configure-context-menu-item />
        </context-menu>
        <encoding id="measures">
            <display-name>Measures</display-name>
            <data-spec>
                <data-type>numeric</data-type>
            </data-spec>
            <role-spec>
                <role-type>continuous-measure</role-type>
            </role-spec>
            <encoding-icon token="letter-m" />
        </encoding>
        <encoding id="ROWS">
            <display-name>Categories</display-name>
            <data-spec>
                <data-type>string</data-type>
                <data-type>temporal</data-type>
                <data-type>numeric</data-type>
                <data-type>boolean</data-type>
            </data-spec>
            <role-spec>
                <role-type>discrete-dimension</role-type>
            </role-spec>
            <encoding-icon token="letter-c" />
        </encoding>
        <encoding id="COLUMNS">
            <display-name>Series</display-name>
            <data-spec>
                <data-type>string</data-type>
                <data-type>temporal</data-type>
                <data-type>numeric</data-type>
                <data-type>boolean</data-type>
            </data-spec>
            <role-spec>
                <role-type>discrete-dimension</role-type>
            </role-spec>
            <encoding-icon token="letter-s" />
        </encoding>
    </worksheet-extension>
    <resources>
        <resource id="name">
            <text locale="en_US">graphomate chartrix</text>
            <text locale="fr_BE">graphomate chartrix</text>
            <text locale="de_DE">graphomate chartrix</text>
        </resource>
    </resources>
</manifest>
