<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.biztory.extensions.autom8" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Autom8 allows you to drive and automate _any_ action taken in Tableau, by wiring it up with your n8n workflow(s).</description>
    <author name="Biztory" email="extensions@biztory.com" organization="Biztory" website="https://www.biztory.com"/>
    <min-api-version>0.8</min-api-version>
    <source-location>
      <url>https://biztory-tableau-extensions.web.app/extensions/autom8/autom8.html</url>
    </source-location>
    <icon></icon>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Autom8</text>
    </resource>
  </resources>
</manifest>
