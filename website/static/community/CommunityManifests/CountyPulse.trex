<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.gbuckleyjr.countypulse" extension-version="0.3.0">
    <default-locale>en_US</default-locale>
    <name>County Pulse</name>
    <description>Animated U.S. county pulse map driven by Tableau Marks card encodings.</description>
    <author name="Greg Buckley" email="gbuckleyjr@users.noreply.github.com" organization="Independent" website="https://github.com/gbuckleyjr/county-pulse-extension" />
    <min-api-version>1.1</min-api-version>
    <source-location>
      <url>https://gbuckleyjr.github.io/county-pulse-extension/index.html</url>
    </source-location>
    <icon></icon>
    <encoding id="fips">
      <display-name>County FIPS</display-name>
      <role-spec>
        <role-type>discrete-dimension</role-type>
        <role-type>continuous-dimension</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="1" />
      <encoding-icon token="globe" />
      <tooltip>Drop a 5-digit U.S. county FIPS field here.</tooltip>
    </encoding>
    <encoding id="value">
      <display-name>Signed Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="1" />
      <encoding-icon token="metric" />
      <tooltip>Drop the signed metric. Positive values render teal; negative values render orange.</tooltip>
    </encoding>
    <encoding id="size">
      <display-name>Magnitude</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="1" />
      <encoding-icon token="size" />
      <tooltip>Optional magnitude metric. If omitted, County Pulse uses absolute Signed Value.</tooltip>
    </encoding>
    <encoding id="label">
      <display-name>Label</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1" />
      <encoding-icon token="text" />
      <tooltip>Optional label for hover text, such as county name.</tooltip>
    </encoding>
  </worksheet-extension>
</manifest>
