<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <workspace-extension id="com.tableau.extension.authoringworkspace" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Authoring</description>
    <author name="Tableau" email="github@tableau.com" organization="Tableau" website="https://www.tableau.com/support"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>https://vizext-devpreview.s3.us-west-2.amazonaws.com/authoring-extensions/authoring.html</url>
    </source-location>
    <icon/>
  </workspace-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Authoring Extension</text>
    </resource>
  </resources>
</manifest>
